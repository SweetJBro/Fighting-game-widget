# Hostnames Caddy will obtain certificates for
LOBBY_HOST=3s.example.com
NETPLAY_HOST=netplay.example.com

# Optional: TURN for players behind strict NATs (JSON array of RTCIceServer).
# Any TURN server works; this example matches the bundled coturn profile below.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:netplay.example.com:3478?transport=udp","username":"fgw","credential":"change-me"}]

# Optional: bundled coturn (docker compose --profile turn up -d). Host networking;
# open UDP 3478 and UDP 49160-49200 on the firewall. TURN_PUBLIC_IP is the box's
# public address (coturn cannot discover it behind NAT).
# TURN_PUBLIC_IP=203.0.113.10
# TURN_USER=fgw
# TURN_PASSWORD=change-me
# TURN_REALM=netplay.example.com     # defaults to NETPLAY_HOST
# TURN_PORT=3478
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49200

# Optional: netplay stream and feel (defaults shown)
# STREAM_FPS=60                  host capture + encode fps, 15-60
# STREAM_BITRATE_DIRECT=4000000  max video bps on a direct peer path
# STREAM_BITRATE_RELAY=1500000   max video bps through TURN
# INPUT_DELAY_DEFAULT=3          host input delay in frames (0-8) until a player picks one
# THREADS=1                      0 = never load the threaded core in pop-out tabs
# MAX_SPECTATORS=2               watch seats per match (each costs the host one video encode)

# Optional: Fluxer bot (docker compose --profile fluxer up -d)
# FLUXER_BOT_TOKEN=<application_id>.<secret>
# FLUXER_INSTANCE=https://fluxer.app
