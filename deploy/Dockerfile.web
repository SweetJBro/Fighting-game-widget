FROM node:22-alpine
RUN apk add --no-cache bash curl tar
WORKDIR /app
COPY web ./web
COPY server ./server
COPY scripts/fetch-emulatorjs.sh ./scripts/
# Pinned EmulatorJS + fbneo core baked into the image (see scripts/fetch-emulatorjs.sh).
ARG EJS_COMMIT=5a65bde5d3b47c75f22e90453c3c14c469411589
ARG CORE_VERSION=4.2.3
RUN EJS_COMMIT=$EJS_COMMIT CORE_VERSION=$CORE_VERSION ./scripts/fetch-emulatorjs.sh
ENV PORT=8080
EXPOSE 8080
CMD ["node", "server/serve.js"]
